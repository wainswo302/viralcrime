# --- API (Spring Boot) ---
# Local Docker Postgres (docker-compose.yml):
DB_URL=jdbc:postgresql://localhost:5432/viralcrime
DB_USER=viralcrime
DB_PASSWORD=viralcrime
# Supabase instead: Project Settings > Database > Connection string > "Session pooler"
# (session pooler, not transaction pooler on :6543 — Flyway/Hibernate need prepared
# statement support the transaction pooler doesn't give you; session pooler also
# works over IPv4, which the direct :5432 host may not on the free plan).
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=<your Supabase DB password>
PORT=8080
# Single shared admin credential, required — protects everything under /api/drafts/**.
# The app fails to start without these set (fail closed, not a guessable default).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-real
# Browser origin allowed to call the API with credentials (CORS). Vercel prod URL in production.
WEB_ORIGIN=http://localhost:3000

# --- Web (Next.js) ---
API_BASE_URL=http://localhost:8080
SITE_URL=https://viralcrime.example
# Browser-side calls (the /admin dashboard) can't read plain env vars — Next.js
# only exposes NEXT_PUBLIC_* ones to client code. Same value as API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Pipeline (Python) ---
# API_BASE_URL is shared with the web app above
# ANTHROPIC_API_KEY=sk-...   # optional: enables LLM-assisted extraction
# Same admin credential as above — the pipeline authenticates as the admin too.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-real
