# --- API (Spring Boot) ---
# Local Docker Postgres (docker-compose.yml):
DB_URL=jdbc:postgresql://localhost:5432/viralcrime
DB_USER=viralcrime
DB_PASSWORD=viralcrime
# Supabase instead: Project Settings > Database > Connection string > "Session pooler"
# (session pooler, not transaction pooler on :6543 — Flyway/Hibernate need prepared
# statement support the transaction pooler doesn't give you; session pooler also
# works over IPv4, which the direct :5432 host may not on the free plan).
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=<your Supabase DB password>
PORT=8080

# --- Web (Next.js) ---
API_BASE_URL=http://localhost:8080
SITE_URL=https://viralcrime.example

# --- Pipeline (Python) ---
# API_BASE_URL is shared with the web app above
# ANTHROPIC_API_KEY=sk-...   # optional: enables LLM-assisted extraction
